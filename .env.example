# Configuração do docker-compose.yml da raiz. Copiar para .env e preencher; o .env nunca vai para o repositório.
# Os valores "changeme" e vazios têm de ser definidos para cada ambiente, com segredos próprios desse ambiente.

# --- Imagens e portas -------------------------------------------------------------------------------------------
# Etiqueta das imagens geradas por `docker compose build` (saigt-api:<versão>, saigt-ui:<versão>).
SAIGT_VERSAO=local
# Porta publicada da saigt-ui (ponto de entrada da plataforma).
SAIGT_UI_PORTA=8080
# Porta da saigt-api, publicada só em 127.0.0.1 (diagnóstico local).
SAIGT_API_PORTA=8081

# --- Base de dados (PostgreSQL) ---------------------------------------------------------------------------------
POSTGRES_DB=saigt
# Dono da base de dados: usado só pelas migrações Liquibase.
POSTGRES_USER=saigt
POSTGRES_PASSWORD=changeme
# Role de runtime da saigt-api (sem UPDATE/DELETE na auditoria), criado no primeiro arranque.
SAIGT_APP_PASSWORD=changeme

# --- Armazenamento de documentos (S3, RustFS) -------------------------------------------------------------------
STORAGE_ACCESS_KEY=saigt
STORAGE_SECRET_KEY=changeme
STORAGE_BUCKET=saigt-documentos

# --- Autenticação -----------------------------------------------------------------------------------------------
JWT_ISSUER=https://auth.saigt.pt
AUTH_DISABLED=false
# Origem pública da saigt-ui (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Clientes OAuth de sistema (client credentials em POST /oauth2/token); só A-Z a-z 0-9 - . _. Vazio = sem cliente.
SAIGT_OAUTH_UI_CLIENT_ID=saigt-ui
SAIGT_OAUTH_SNIT_CLIENT_ID=
SAIGT_OAUTH_SNIT_CLIENT_SECRET=
SAIGT_OAUTH_GEOCONFORM_CLIENT_ID=
SAIGT_OAUTH_GEOCONFORM_CLIENT_SECRET=

# Active Directory (utilizadores DGT). {0} é o username: UPN {0}@dominio, nome simples {0}, ou um DN.
LDAP_URL=ldap://changeme
LDAP_BASE_DN=dc=dgt,dc=pt
LDAP_BIND_FORMAT={0}
# Username AD (não o email) do primeiro utilizador MASTER, criado no arranque.
ADMIN_ARRANQUE_EMAIL=
# Sem AD acessível, o health check LDAP põe a saigt-api em DOWN e a saigt-ui não arranca; "false" desliga-o.
MANAGEMENT_HEALTH_LDAP_ENABLED=true
# Login simulado, só para desenvolvimento sem AD. NUNCA true num ambiente da DGT.
APP_LDAP_MOCK_ENABLED=false

# --- Integrações externas ---------------------------------------------------------------------------------------
INCM_BASE_URL=
INCM_SERVICE_KEY=
SNIT_BASE_URL=
SNIT_API_KEY=
# Sincronização da réplica das tabelas de referência do SNIT (cron do Spring, com segundos); "-" desliga-a.
SNIT_REFERENCIA_CRON=0 0 3 * * *
SNIT_REFERENCIA_SINCRONIZAR_AO_ARRANCAR=true
# Caixas da pasta de depósito servida ao SNIT: DEPOSITO, PUBLICACAO ou PUBLICACAO,DEPOSITO.
SNIT_DEPOSITO_CAIXAS=DEPOSITO
PCGT_BASE_URL=
PCGT_USERNAME=
PCGT_PASSWORD=
GEOCONFORM_BASE_URL=
GEOCONFORM_TOKEN_URL=
GEOCONFORM_CLIENT_ID=
GEOCONFORM_CLIENT_SECRET=

# --- Email (relay SMTP da DGT) ----------------------------------------------------------------------------------
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=25
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Cópia das notificações por email; com ATIVO=true é obrigatório o remetente.
APP_NOTIFICACOES_EMAIL_ATIVO=false
APP_NOTIFICACOES_EMAIL_REMETENTE=

# --- Descarga de documentos por ticket --------------------------------------------------------------------------
# Endereço público da plataforma, usado nos links de descarga enviados a terceiros.
APP_PUBLICO_BASE_URL=http://localhost:8080
# Chaves HMAC dos tickets, id:segredo (vírgula separa várias, para rotação; segredo com 32 bytes ou mais).
APP_DOCUMENTOS_DESCARGA_CHAVES=k1:changeme-chave-hmac-com-pelo-menos-32-bytes
APP_DOCUMENTOS_DESCARGA_CHAVE_ATIVA=k1
