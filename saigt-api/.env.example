SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/saigt
SPRING_DATASOURCE_USERNAME=saigt
SPRING_DATASOURCE_PASSWORD=saigt
JWT_ISSUER=https://auth.saigt.pt
JWT_JWKS_URI=http://localhost:8080/oauth2/jwks
JWT_PRIVATE_KEY_PATH=
AUTH_DISABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Username AD (não o email) do primeiro MASTER.
ADMIN_ARRANQUE_EMAIL=
LDAP_URL=
LDAP_BASE_DN=
# Principal do bind do login AD; {0} é o username (UPN {0}@dominio, nome simples {0} ou um DN).
LDAP_BIND_FORMAT={0}
# Mock de login LDAP para dev local, sem AD real (issue #76) — NUNCA true em produção.
APP_LDAP_MOCK_ENABLED=false
INCM_BASE_URL=
INCM_SERVICE_KEY=
SNIT_BASE_URL=
SNIT_API_KEY=
# Cadência da sincronização da réplica das tabelas de referência do SNIT (cron do Spring, com segundos).
# Por omissão, todos os dias às 03:00. "-" desliga-a; "0 * * * * *" corre-a a cada minuto. Não deixar vazia.
SNIT_REFERENCIA_CRON=0 0 3 * * *
# Caixas da pasta de depósito servida ao SNIT: DEPOSITO (omissão), PUBLICACAO ou PUBLICACAO,DEPOSITO.
SNIT_DEPOSITO_CAIXAS=DEPOSITO
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=saigt
STORAGE_SECRET_KEY=saigt12345
STORAGE_BUCKET=saigt-documentos

# Descarga de documentos por ticket (valores de exemplo; segredos reais fora do repositorio)
APP_PUBLICO_BASE_URL=http://localhost:8080
APP_DOCUMENTOS_DESCARGA_CHAVES=k1:changeme-chave-hmac-com-pelo-menos-32-bytes
APP_DOCUMENTOS_DESCARGA_CHAVE_ATIVA=k1
