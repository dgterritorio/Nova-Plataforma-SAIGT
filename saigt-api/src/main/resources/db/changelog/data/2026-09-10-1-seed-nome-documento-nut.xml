<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-09-10-1-seed-nome-documento-nut" author="nuno.miguel.silva">
        <comment>
            Issue #122 — seed por developers (sem CRUD, sem botão + no ecrã).
            Ordem curada do mockup, não alfabética. Não inserir "id": nenhuma
            linha é referenciada por número e inserir ids explícitos não
            avança a sequência do Postgres (colide no primeiro insert da
            aplicação).
        </comment>

        <loadData tableName="nome_documento" file="db/data/2026-09-10-1-nome_documento.csv"
                  relativeToChangelogFile="false" separator=";" quotchar="&quot;" encoding="UTF-8">
            <column name="nome" type="STRING"/>
            <column name="ordem" type="NUMERIC"/>
        </loadData>

        <loadData tableName="nut" file="db/data/2026-09-10-1-nut.csv"
                  relativeToChangelogFile="false" separator=";" quotchar="&quot;" encoding="UTF-8">
            <column name="codigo" type="STRING"/>
            <column name="nome" type="STRING"/>
            <column name="ordem" type="NUMERIC"/>
        </loadData>

        <rollback>
            <delete tableName="nut"/>
            <delete tableName="nome_documento"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
