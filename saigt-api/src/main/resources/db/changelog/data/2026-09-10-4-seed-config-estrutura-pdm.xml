<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-09-10-4-seed-config-estrutura-pdm" author="nuno.miguel.silva">
        <comment>
            Issue #123 — Grupo 2: instrumento_dinamica_config (13 linhas) e
            instrumento_procedimento_config (20, primeiro lote das dinâmicas
            1-9). Fonte: pdm-mapeamento-configuracao.md §13.4-13.5. Ids
            explícitos (referenciados por §13.6-13.7); setval no fim.
        </comment>

        <loadData tableName="instrumento_dinamica_config" file="db/data/2026-09-10-4-instrumento_dinamica_config.csv"
                  relativeToChangelogFile="false" separator=";" quotchar="&quot;" encoding="UTF-8">
            <column name="id" type="NUMERIC"/>
            <column name="tipo_instrumento_id" type="NUMERIC"/>
            <column name="tipo_dinamica_id" type="NUMERIC"/>
            <column name="ordem" type="NUMERIC"/>
            <column name="ativo" type="BOOLEAN"/>
        </loadData>
        <sql dbms="postgresql">SELECT setval(pg_get_serial_sequence('instrumento_dinamica_config', 'id'), (SELECT MAX(id) FROM instrumento_dinamica_config))</sql>

        <loadData tableName="instrumento_procedimento_config" file="db/data/2026-09-10-4-instrumento_procedimento_config.csv"
                  relativeToChangelogFile="false" separator=";" quotchar="&quot;" encoding="UTF-8">
            <column name="id" type="NUMERIC"/>
            <column name="instrumento_dinamica_config_id" type="NUMERIC"/>
            <column name="tipo_procedimento_id" type="NUMERIC"/>
            <column name="ordem" type="NUMERIC"/>
            <column name="serie_dr" type="STRING"/>
            <column name="obrigatorio" type="BOOLEAN"/>
            <column name="ativo" type="BOOLEAN"/>
            <column name="nota" type="SKIP"/>
        </loadData>

        <sql dbms="postgresql">SELECT setval(pg_get_serial_sequence('instrumento_procedimento_config', 'id'), (SELECT MAX(id) FROM instrumento_procedimento_config))</sql>

        <rollback>
            <delete tableName="instrumento_procedimento_config">
                <where>id BETWEEN 201 AND 220</where>
            </delete>
            <delete tableName="instrumento_dinamica_config">
                <where>id BETWEEN 101 AND 113</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
