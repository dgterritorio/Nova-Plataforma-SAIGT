<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-09-28-2-seed-permissao-acao-pu-pp" author="nuno.miguel.silva">
        <comment>
            Issue #162 — permissao_acao para PP e PU (36 por tipo, duas por
            procedimento — ENTIDADE submete, DGT valida). Espelho de
            2026-09-10-5 (PDM §13.7). Um procedimento sem linha para o ator do
            utilizador falha a Camada 3 de autorização. Ids explícitos + setval.
        </comment>

        <loadData tableName="permissao_acao" file="db/data/2026-09-28-2-permissao_acao.csv"
                  relativeToChangelogFile="false" separator=";" quotchar="&quot;" encoding="UTF-8">
            <column name="id" type="NUMERIC"/>
            <column name="instrumento_procedimento_config_id" type="NUMERIC"/>
            <column name="ator" type="STRING"/>
            <column name="ativo" type="BOOLEAN"/>
        </loadData>

        <sql dbms="postgresql">SELECT setval(pg_get_serial_sequence('permissao_acao', 'id'), (SELECT MAX(id) FROM permissao_acao))</sql>

        <rollback>
            <delete tableName="permissao_acao">
                <where>id BETWEEN 2601 AND 2636 OR id BETWEEN 3601 AND 3636</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
