<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-11-13-9-seed-tipo-procedimento-srup" author="arnaldo.costa">
        <comment>
            Tipo de Procedimento das restantes servidões, que só têm o ato de publicação final (EF v1.5, «SRUP – Fluxo»).
            Tem o formulário genérico SRUP (cabeçalho comum) e nenhuma configuração o usa até à configuração das
            restantes servidões. Sem id explícito.
        </comment>

        <insert tableName="tipo_procedimento">
            <column name="codigo" value="PUBLICACAO_SRUP"/>
            <column name="nome" value="Publicação da servidão"/>
            <column name="ativo" valueBoolean="true"/>
        </insert>

        <rollback>
            <sql>DELETE FROM tipo_procedimento WHERE codigo = 'PUBLICACAO_SRUP'</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
