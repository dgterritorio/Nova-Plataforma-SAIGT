<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-11-03-1-create-instrumento-concelho" author="margarida.marques">
        <comment>
            Concelhos do Instrumento, fixados na Decisão de elaborar. municipio_codigo é o
            código MUNICIPALITIES de snit_referencia, sem FK: a réplica só é única por (lista, codigo).
        </comment>

        <createTable tableName="instrumento_concelho">
            <column name="instrumento_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_instrumento_concelho_instrumento" references="instrumento(id)"/>
            </column>
            <column name="municipio_codigo" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="instrumento_concelho" columnNames="instrumento_id, municipio_codigo"
                       constraintName="pk_instrumento_concelho"/>
        <createIndex tableName="instrumento_concelho" indexName="idx_instrumento_concelho_municipio">
            <column name="municipio_codigo"/>
        </createIndex>

        <rollback>
            <dropTable tableName="instrumento_concelho"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
