<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-11-03-2-remove-ordem-instrumento-dinamica-config" author="david.raposo">
        <comment>
            A ordem das Dinâmicas de um tipo de Instrumento seguia a do catálogo `tipo_dinamica` em todas as linhas
            do seed e o LLD (DB-PROC-004) já não a tem. A ordem dos Procedimentos (`instrumento_procedimento_config.ordem`)
            mantém-se. O rollback repõe a coluna com a ordem do catálogo (`tipo_dinamica_id`).
        </comment>

        <dropColumn tableName="instrumento_dinamica_config" columnName="ordem"/>

        <rollback>
            <addColumn tableName="instrumento_dinamica_config">
                <column name="ordem" type="INTEGER"/>
            </addColumn>
            <sql>UPDATE instrumento_dinamica_config SET ordem = tipo_dinamica_id</sql>
            <addNotNullConstraint tableName="instrumento_dinamica_config" columnName="ordem" columnDataType="INTEGER"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
