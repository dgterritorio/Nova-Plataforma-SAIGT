<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-11-05-1-create-processo-rejeicao" author="margarida.marques">
        <comment>
            Uma linha por recusa do processo, numerada por processo e com a origem (DGT ou INCM); só inserção.
            O ALTER DEFAULT PRIVILEGES de 2026-08-11-8 dá à saigt_app UPDATE e DELETE em tabelas novas, por isso
            revogam-se aqui.
        </comment>

        <createTable tableName="processo_rejeicao">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="processo_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_processo_rejeicao_processo" references="processo(id)"/>
            </column>
            <column name="sequencia" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="origem" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="motivo_texto" type="TEXT"/>
            <column name="notas_gerais" type="TEXT"/>
            <column name="criado_em" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="criado_por" type="UUID">
                <constraints foreignKeyName="fk_processo_rejeicao_criado_por" references="utilizador(id)"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="processo_rejeicao" columnNames="processo_id, sequencia"
                             constraintName="uq_processo_rejeicao_sequencia"/>
        <sql>ALTER TABLE processo_rejeicao ADD CONSTRAINT ck_processo_rejeicao_origem
            CHECK (origem IN ('DGT', 'INCM'))</sql>
        <sql>ALTER TABLE processo_rejeicao ADD CONSTRAINT ck_processo_rejeicao_motivo_incm
            CHECK (origem &lt;&gt; 'INCM' OR motivo_texto IS NOT NULL)</sql>
        <sql>ALTER TABLE processo_rejeicao ADD CONSTRAINT ck_processo_rejeicao_sequencia
            CHECK (sequencia &gt;= 1)</sql>

        <createIndex tableName="processo_rejeicao" indexName="idx_processo_rejeicao_processo_id">
            <column name="processo_id"/>
        </createIndex>

        <sql>REVOKE UPDATE, DELETE ON processo_rejeicao FROM saigt_app</sql>

        <rollback>
            <dropTable tableName="processo_rejeicao"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
