<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-11-09-4-planta-varias-linhas-por-documento" author="pedro.paixao">
        <comment>
            Um ZIP das Plantas dá uma linha de planta por folha, por isso o documento deixa de ser único na tabela
            planta. O índice substitui o que a unicidade dava às pesquisas por documento.
        </comment>

        <dropUniqueConstraint tableName="planta" constraintName="uq_planta_processo_documento"/>
        <createIndex tableName="planta" indexName="idx_planta_processo_documento_id">
            <column name="processo_documento_id"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="planta" indexName="idx_planta_processo_documento_id"/>
            <addUniqueConstraint tableName="planta" columnNames="processo_documento_id"
                                 constraintName="uq_planta_processo_documento"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
