<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-11-11-1-create-notificacoes" author="margarida.marques">
        <comment>
            Centro de Notificações: notificações, mensagens da conversação e anexos. O histórico não se apaga (a
            leitura, a resolução e a limpeza só mudam o estado), por isso revoga-se o DELETE que o ALTER DEFAULT
            PRIVILEGES de 2026-08-11-8 dá à saigt_app em notificacao e notificacao_mensagem. Os anexos mantêm o
            DELETE enquanto a sua gestão não estiver fechada.
        </comment>

        <createTable tableName="notificacao">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tipo" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="titulo" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="texto" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="processo_id" type="UUID">
                <constraints foreignKeyName="fk_notificacao_processo" references="processo(id)"/>
            </column>
            <column name="id_igt_snit" type="TEXT"/>
            <column name="descricao_igt" type="TEXT"/>
            <column name="utilizador_id" type="UUID">
                <constraints foreignKeyName="fk_notificacao_utilizador" references="utilizador(id)"/>
            </column>
            <column name="entidade_id" type="BIGINT">
                <constraints foreignKeyName="fk_notificacao_entidade" references="entidade(id)"/>
            </column>
            <column name="perfil_destino" type="VARCHAR(20)"/>
            <column name="lote_id" type="UUID"/>
            <column name="prazo" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="estado" type="VARCHAR(20)" defaultValue="ATIVA">
                <constraints nullable="false"/>
            </column>
            <column name="canal_email" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="email_enviado_em" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="criado_por" type="UUID">
                <constraints foreignKeyName="fk_notificacao_criado_por" references="utilizador(id)"/>
            </column>
            <column name="criado_em" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="atualizado_em" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="lido_em" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="resolvido_em" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <sql>ALTER TABLE notificacao ADD CONSTRAINT ck_notificacao_tipo
            CHECK (tipo IN ('ESTATICA', 'TEMPORARIA', 'RESPOSTA_OBRIGATORIA', 'PEDIDO_APOIO',
            'REGULARIZACAO_PROCEDIMENTO', 'ALERTA'))</sql>
        <sql>ALTER TABLE notificacao ADD CONSTRAINT ck_notificacao_estado
            CHECK (estado IN ('ATIVA', 'LIDA', 'RESOLVIDA', 'DESATIVADA', 'REMOVIDA'))</sql>
        <sql>ALTER TABLE notificacao ADD CONSTRAINT ck_notificacao_perfil_destino
            CHECK (perfil_destino IS NULL OR perfil_destino = 'MASTER')</sql>
        <sql>ALTER TABLE notificacao ADD CONSTRAINT ck_notificacao_prazo
            CHECK (prazo IS NULL OR tipo IN ('ESTATICA', 'RESPOSTA_OBRIGATORIA'))</sql>

        <createIndex tableName="notificacao" indexName="idx_notificacao_tipo">
            <column name="tipo"/>
        </createIndex>
        <createIndex tableName="notificacao" indexName="idx_notificacao_processo">
            <column name="processo_id"/>
        </createIndex>
        <createIndex tableName="notificacao" indexName="idx_notificacao_utilizador">
            <column name="utilizador_id"/>
        </createIndex>
        <createIndex tableName="notificacao" indexName="idx_notificacao_entidade">
            <column name="entidade_id"/>
        </createIndex>
        <createIndex tableName="notificacao" indexName="idx_notificacao_perfil_destino">
            <column name="perfil_destino"/>
        </createIndex>
        <createIndex tableName="notificacao" indexName="idx_notificacao_lote">
            <column name="lote_id"/>
        </createIndex>
        <createIndex tableName="notificacao" indexName="idx_notificacao_estado">
            <column name="estado"/>
        </createIndex>
        <createIndex tableName="notificacao" indexName="idx_notificacao_criado_em">
            <column name="criado_em"/>
        </createIndex>

        <createTable tableName="notificacao_mensagem">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="notificacao_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_notificacao_mensagem_notificacao"
                             references="notificacao(id)"/>
            </column>
            <column name="autor_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_notificacao_mensagem_autor"
                             references="utilizador(id)"/>
            </column>
            <column name="texto" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="criado_em" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="atualizado_em" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="notificacao_mensagem" indexName="idx_notificacao_mensagem_notificacao">
            <column name="notificacao_id"/>
        </createIndex>

        <createTable tableName="notificacao_documento">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="notificacao_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_notificacao_documento_notificacao"
                             references="notificacao(id)"/>
            </column>
            <column name="nome_ficheiro" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="caminho_ficheiro" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="tamanho_bytes" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="criado_por" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_notificacao_documento_criado_por"
                             references="utilizador(id)"/>
            </column>
            <column name="criado_em" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="atualizado_em" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="notificacao_documento" indexName="idx_notificacao_documento_notificacao">
            <column name="notificacao_id"/>
        </createIndex>

        <sql>REVOKE DELETE ON notificacao FROM saigt_app</sql>
        <sql>REVOKE DELETE ON notificacao_mensagem FROM saigt_app</sql>

        <rollback>
            <dropTable tableName="notificacao_documento"/>
            <dropTable tableName="notificacao_mensagem"/>
            <dropTable tableName="notificacao"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
