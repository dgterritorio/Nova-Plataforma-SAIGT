<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-11-13-3-processo-observacoes-outros" author="david.raposo">
        <comment>
            A secção «Outros» passa a ser igual às restantes: publicação ou depósito e um campo de observações. Como não
            tem item documental, as observações ficam no processo.
        </comment>

        <addColumn tableName="processo">
            <column name="observacoes_outros" type="TEXT"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="processo" columnName="observacoes_outros"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
