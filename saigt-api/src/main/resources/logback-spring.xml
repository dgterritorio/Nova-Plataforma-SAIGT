<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log técnico só na saída padrão; o destino, a agregação e a retenção são da infraestrutura (TR-258). Nunca um
  appender de ficheiro ou de base de dados: o log técnico não tem retenção na aplicação e não alimenta a auditoria
  (TR-132).
  Por omissão, JSON (um evento por linha). O perfil "local" (SPRING_PROFILES_ACTIVE=local) é só para desenvolvimento
  fora dos contentores e escreve texto legível.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="local">
        <appender name="CONSOLE_TEXTO" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} %5p [%X{apiTraceId:-}] [%15.15t] %-40.40logger{39} : %m %kvp%n%ex</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_TEXTO"/>
        </root>
    </springProfile>

    <springProfile name="!local">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="com.conkord.saigt.configuration.EncoderLogJson"/>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>
</configuration>
